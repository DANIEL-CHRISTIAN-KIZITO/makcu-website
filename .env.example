# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://postgres:password@localhost:5432/mak_cu_db

# Session secret - generate a long random string
SESSION_SECRET=change_this_to_a_long_random_string

# Payment provider (Flutterwave example - swap for Paystack if preferred)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# Optional: for admin account bootstrap script
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
