<section class="container page">
    <div class="page-intro">
        <div class="page-intro-copy">
            <h1>Gallery</h1>
            <p>A glimpse of worship, outreach, teaching, and friendship across the MAK CU family.</p>
        </div>
        <img class="page-intro-image" src="/img/mission-speaker.jpg" alt="A MAK CU student sharing during ministry">
    </div>
    <div class="gallery-grid curated-gallery">
        <div class="gallery-item"><img src="/img/mission-community.jpg" alt="Community outreach"></div>
        <div class="gallery-item"><img src="/img/mission-outreach-team.jpg" alt="Outreach team"></div>
        <div class="gallery-item"><img src="/img/fellowship-conversation.jpg" alt="Fellowship conversation"></div>
        <div class="gallery-item"><img src="/img/scripture-bondage.jpg" alt="Scripture display about freedom in Christ"></div>
        <div class="gallery-item"><img src="/img/scripture-disciples.jpg" alt="Scripture display about discipleship"></div>
        <div class="gallery-item"><img src="/img/mission-preacher.jpg" alt="A Christ Ambassador preaching during outreach"></div>
        <div class="gallery-item"><img src="/img/mission-testimony.jpg" alt="A missioner sharing the Word during evangelism"></div>
        <div class="gallery-item"><img src="/img/mission-team-address.jpg" alt="Mission team members addressing the community"></div>
        <div class="gallery-item"><img src="/img/mission-outreach-worship.jpg" alt="Worship during a campus outreach"></div>
        <div class="gallery-item"><img src="/img/mission-evening-worship.jpg" alt="A student worshipping during an evening gathering"></div>
        <div class="gallery-item"><img src="/img/mission-altar-call.jpg" alt="A minister giving an altar call during outreach"></div>
        <div class="gallery-item"><img src="/img/fellowship-testimony-night.jpg" alt="A student sharing a testimony on stage"></div>
        <div class="gallery-item"><img src="/img/mission-outreach-speaker.jpg" alt="A missioner speaking during an outreach event"></div>
    </div>
    <h2 class="gallery-upload-heading">Latest uploads</h2>
    <% if (images.length === 0) { %>
        <p>No photos posted yet.</p>
    <% } else { %>
        <div class="gallery-grid">
            <% images.forEach(img => { %>
                <div class="gallery-item">
                    <img src="<%= img.image_path %>" alt="<%= img.title || 'MAK MAIN CU photo' %>">
                    <% if (img.title) { %><p><%= img.title %></p><% } %>
                </div>
            <% }) %>
        </div>
    <% } %>
</section>
