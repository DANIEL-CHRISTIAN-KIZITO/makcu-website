<section class="container page">
    <div class="page-intro">
        <div class="page-intro-copy">
            <h1>Contact Us</h1>
            <p>We would love to hear from you, pray with you, and help you find your place in the MAK CU family.</p>
        </div>
        <img class="page-intro-image" src="/img/fellowship-leaders.jpg" alt="MAK CU fellowship leaders">
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
        <p class="form-success">Thanks for reaching out — we'll respond soon.</p>
    <% } else { %>
        <% if (typeof error !== 'undefined') { %><p class="form-error"><%= error %></p><% } %>
        <form action="/contact" method="POST">
            <label>Name<input type="text" name="name" required></label>
            <label>Email<input type="email" name="email" required></label>
            <label>Message<textarea name="message" rows="5" required></textarea></label>
            <button type="submit" class="btn">Send Message</button>
        </form>
    <% } %>

    <hr>
