<footer class="site-footer">
    <div class="container">
        <p id="footer-copyright" style="cursor: pointer;">&copy; <%= new Date().getFullYear() %> Makerere Christian Union Fellowship. All rights reserved.</p>
        <!-- Admin access: Click the copyright symbol (©) 3 times quickly -->
    </div>
</footer>

<script>
    // Hidden admin access: Click the copyright (©) symbol 3 times within 2 seconds
    let clickCount = 0;
    let clickTimer = null;
    const footerCopyright = document.getElementById('footer-copyright');
    
    footerCopyright.addEventListener('click', function() {
        clickCount++;
        clearTimeout(clickTimer);
        
        if (clickCount === 3) {
            window.location.href = '/admin/login';
            clickCount = 0;
        }
        
        clickTimer = setTimeout(() => {
            clickCount = 0;
        }, 2000);
    });
</script>
