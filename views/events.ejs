<section class="container page">
    <div class="page-intro">
        <div class="page-intro-copy">
            <h1>Events</h1>
            <p>Find your next place to worship, learn, serve, and grow with the MAK CU family.</p>
            <a href="/join" class="btn">Join the community</a>
        </div>
        <img class="page-intro-image" src="/img/fellowship-classroom.jpg" alt="Students gathered during a MAK CU fellowship">
    </div>
    <% if (events.length === 0) { %>
        <p>No events posted yet.</p>
    <% } else { %>
        <div class="event-cards">
            <% events.forEach(event => { %>
                <div class="event-card">
                    <div class="event-poster">
                        <span class="event-poster-tag">Upcoming Event</span>
                        <% if (event.image_path) { %>
                            <img src="<%= event.image_path %>" alt="<%= event.title %>">
                        <% } else { %>
                            <img src="/img/mission-evening-worship.jpg" alt="<%= event.title %>">
                        <% } %>
                    </div>
                    <h3><%= event.title %></h3>
                    <p class="event-date"><%= new Date(event.event_date).toDateString() %></p>
                    <a href="/events/<%= event.id %>">Details &rarr;</a>
                </div>
            <% }) %>
        </div>
    <% } %>
</section>
